---
import Layout from '../layouts/Layout.astro'; import Card from '../components/Card.astro'; import {projects,steps} from '../data/catalog.js';
---
<Layout title="工具库"><div class="wrap page"><div class="page-intro compact"><div class="kicker">EXPLORE THE TOOLS / 03</div><h1>找到你的工具<span class="accent">.</span></h1><p>从创作需求出发，探索开源项目。数据来自 GitHub 公开仓库信息。</p></div><form class="search-form catalog-search" id="search-form"><label class="sr-only" for="query">搜索工具、功能或创作场景</label><span>⌕</span><input id="query" name="q" placeholder="搜索工具、功能或创作场景"/><button>搜索 <b>↗</b></button></form><div class="filter-row"><label>创作阶段 <select id="category" name="category"><option value="">全部阶段</option>{steps.map(s=><option value={s.id}>{s.name}</option>)}</select></label><label>显卡 <select id="gpu"><option value="">全部</option><option>未确认</option><option>无需</option><option>可选</option><option>需要</option></select></label><label>难度 <select id="difficulty"><option value="">全部</option><option>未确认</option><option>入门</option><option>进阶</option><option>专业</option></select></label><button type="button" id="reset" class="reset">清除筛选</button></div><div class="result-head"><div><span class="kicker">PROJECT DIRECTORY</span><h2>工具目录</h2></div><p id="count" role="status">共 {projects.length} 个项目</p></div><div class="cards-grid" id="results">{projects.map(project=><Card project={project}/>)}</div><div id="no-results" class="empty" hidden><span>⌕</span><h3>没有找到匹配的项目</h3><p>试试其他关键词，或清除筛选条件。</p><button type="button" id="empty-reset" class="outline-btn">清除筛选</button></div></div></Layout>
<script>
const q=document.querySelector<HTMLInputElement>('#query')!; const category=document.querySelector<HTMLSelectElement>('#category')!; const gpu=document.querySelector<HTMLSelectElement>('#gpu')!; const difficulty=document.querySelector<HTMLSelectElement>('#difficulty')!; const cards=[...document.querySelectorAll<HTMLElement>('[data-project]')]; const params=new URLSearchParams(location.search); q.value=params.get('q')||''; category.value=params.get('category')||''; gpu.value=params.get('gpu')||''; difficulty.value=params.get('difficulty')||'';
function update(){const words=q.value.trim().toLowerCase().split(/\s+/).filter(Boolean); let count=0; for(const el of cards){const p=JSON.parse(el.dataset.project!); const hay=[p.name,p.repo,p.summary,...p.tags].join(' ').toLowerCase(); const match=words.every(w=>hay.includes(w))&&(!category.value||p.category===category.value)&&(!gpu.value||p.gpu===gpu.value)&&(!difficulty.value||p.difficulty===difficulty.value); el.hidden=!match; if(match)count++;} document.querySelector('#count')!.textContent=`共 ${count} 个项目`; (document.querySelector('#no-results') as HTMLElement).hidden=count>0; const url=new URL(location.href); for(const [k,v] of [['q',q.value.trim()],['category',category.value],['gpu',gpu.value],['difficulty',difficulty.value]]){if(v)url.searchParams.set(k,v);else url.searchParams.delete(k);} history.replaceState(null,'',url);}
document.querySelector('#search-form')!.addEventListener('submit',e=>{e.preventDefault();update()}); q.addEventListener('input',update); for(const el of [category,gpu,difficulty])el.addEventListener('change',update); function reset(){q.value='';category.value='';gpu.value='';difficulty.value='';update()} document.querySelector('#reset')!.addEventListener('click',reset);document.querySelector('#empty-reset')!.addEventListener('click',reset);update();
</script>
