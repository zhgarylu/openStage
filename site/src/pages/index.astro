---
import Layout from '../layouts/Layout.astro'; import Card from '../components/Card.astro'; import StepCard from '../components/StepCard.astro'; import {steps,projects,capturedAt} from '../data/catalog.js'; import weekly from '../data/weekly.json';
---
<Layout><section class="hero"><div class="wrap hero-content"><div class="eyebrow"><i></i> THE OPEN TOOLKIT FOR CREATORS</div><h1>让创意，<br/><em>走上舞台。</em></h1><p>发现适合 AI 短片创作的开源工具。<br/>从故事到成片，每一步都更有方向。</p><form class="search-form hero-search" action="/search/"><label class="sr-only" for="home-search">搜索工具</label><span>⌕</span><input id="home-search" name="q" placeholder="搜索工具、功能或创作场景"/><button type="submit">搜索工具 <b>↗</b></button></form><div class="hero-hint">探索热门方向 <a href="/flow/s3/">图像生成</a><a href="/flow/s4/">视频生成</a><a href="/flow/s5/">AI 配音</a></div></div></section>
<div class="wrap"><div class="notice"><span>✳</span><p><strong>验证版说明</strong> 收录项目来自 GitHub 公开资料，未经过实测；使用前请核对原仓库。</p><a href="/about/">了解更多 ↗</a></div><section class="section"><div class="section-head"><div><div class="kicker">THE CREATIVE PROCESS <span> / 01</span></div><h2>创作的每一步，都有工具可用<span class="accent">.</span></h2><p>从一个想法出发，找到适合当前阶段的工具。</p></div><a class="text-link" href="/flow/">查看完整流程 <span>↗</span></a></div><div class="steps-grid">{steps.map(step=><StepCard step={step}/>)}</div></section>
<section class="section"><div class="section-head"><div><div class="kicker">THE WEEKLY SIGNAL <span> / 02</span></div><h2>本周观察<span class="accent">.</span></h2><p>关注开源世界里的新动向，留下真正值得看的项目。</p></div><a class="text-link" href="/weekly/">了解榜单规则 <span>↗</span></a></div>{weekly.length ? <div class="weekly-empty"><div><span class="live-dot"></span><span class="mono">LATEST APPROVED ISSUE</span><h3>{weekly[0].week} · 已审核</h3><p>本期收录 {weekly[0].projects.length} 个项目，数据截至 {weekly[0].end.slice(0,10)}。</p></div><a class="outline-btn" href="/weekly/">查看本期 ↗</a></div> : <div class="weekly-empty"><div><span class="live-dot"></span><span class="mono">COLLECTING SIGNALS</span><h3>第一期榜单正在准备</h3><p>真实涨星数据需要时间积累。完成采集与审核后，我们会在这里发布。</p></div><a class="outline-btn" href="/weekly/">查看榜单说明 ↗</a><span class="weekly-number">01<span> / WEEKLY</span></span></div>}</section>
<section class="section"><div class="section-head"><div><div class="kicker">EXPLORE THE TOOLS <span> / 03</span></div><h2>从这里开始探索<span class="accent">.</span></h2><p>项目用途根据 GitHub 仓库描述整理，具体使用条件请查看原仓库。</p></div><a class="text-link" href="/search/">浏览全部工具 <span>↗</span></a></div><div class="cards-grid">{projects.slice(0,4).map(project=><Card project={project}/>)}</div></section><section class="end-banner"><div><div class="kicker">MADE FOR CREATORS</div><h2>每一个好故事，<br/>都值得被看见<span class="accent">.</span></h2><p>我们整理工具，你专注创作。</p></div><a href="/about/" class="outline-btn">了解 OpenStage ↗</a></section></div></Layout>
